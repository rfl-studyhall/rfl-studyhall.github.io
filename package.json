{
  "name": "studyhall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "VITE_DEV_MODE=true vite build --mode development",
    "bundle": "VITE_DEV_MODE=false vite build && node scripts/bundle.mjs index.html",
    "bundle:dev": "VITE_DEV_MODE=true VITE_POSTHOG_KEY= VITE_POSTHOG_HOST= vite build --mode development && node scripts/bundle.mjs index.dev.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.9",
    "i18next": "^26.4.2",
    "posthog-js": "^1.418.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^4.5.3"
  }
}
